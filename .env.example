# Скопируйте в .env и заполните: cp .env.example .env
# Сам .env исключён из Git.

# Supabase — проект, где лежит таблица contract_chunks.
# URL и ключ: Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-project-key

# Модель генерации в формате LiteLLM: "<провайдер>/<модель>".
# Значения по умолчанию нет намеренно: молчаливый фолбэк на локальную модель,
# которая может быть не запущена, превращает ошибку конфигурации в таймаут.
#
# Локально и бесплатно (нужен установленный Ollama и `ollama pull qwen2.5:7b`):
GENERATION_MODEL=ollama/qwen2.5:7b

# Модель-судья для eval/run_eval.py. Обязана отличаться от GENERATION_MODEL:
# модель, оценивающая свои же ответы, систематически завышает faithfulness.
JUDGE_MODEL=ollama/llama3.1:8b
# Платные провайдеры — сменить строку и добавить ключ, правок кода не требуется:
#   GENERATION_MODEL=anthropic/claude-sonnet-4-6   + ANTHROPIC_API_KEY=...
#   GENERATION_MODEL=openai/gpt-4o                 + OPENAI_API_KEY=...
